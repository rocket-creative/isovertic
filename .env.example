# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Resend: resend.com -> API Keys. Verify the sending domain first.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=sale@isovertic.com
LEAD_FROM_EMAIL=sale@isovertic.com
NEXT_PUBLIC_SITE_URL=https://isovertic.com
# Stripe: self serve Baseline checkout. Test keys first (sk_test_ / whsec_), live keys when ready.
# Products and prices are created on first checkout from content/tiers.ts, keyed by lookup_key. No dashboard setup needed.
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> add endpoint https://isovertic.com/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#         customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
# ACH Direct Debit must be on under Settings, Payment methods (it is on in live as of 2026-09-05).
STRIPE_WEBHOOK_SECRET=
