# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Resend: resend.com -> API Keys. Verify the sending domain first.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=georgestoff@rocketcreative.net
LEAD_FROM_EMAIL=georgestoff@rocketcreative.net
NEXT_PUBLIC_SITE_URL=https://isovertic.com
# Stripe: self serve Baseline checkout. Test keys first (sk_test_ / whsec_), live keys when ready.
# Products and prices are created on first checkout from content/tiers.ts, keyed by lookup_key. No dashboard setup needed.
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> add endpoint https://isovertic.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
